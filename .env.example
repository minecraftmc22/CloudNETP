# ============ 拷贝为 .env 后填写 ============

# --- 应用 ---
APP_NAME=CloudNETP
DEBUG=true

# --- 安全（务必改成一个长随机串，改了会让所有旧会话失效）---
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
COOKIE_NAME=cloudnetp_session
# 公网 HTTPS 部署时改为 true
COOKIE_SECURE=false
SESSION_TTL_SECONDS=1209600

# --- 数据库 ---
# 本地开发（默认，无需安装任何服务）：
DATABASE_URL=sqlite:///./dev.db
# 远程 MySQL（把 用户名/密码/主机/库名 换成你自己的）：
# DATABASE_URL=mysql+pymysql://用户名:密码@主机:3306/库名?charset=utf8mb4
DB_ECHO=false

# --- 数据库容灾 ---
# 主库连不上时自动降级本地 SQLite（storage/db/fallback.db）继续服务，
# 主库恢复后自动回迁并切回。按单实例部署设计，多实例同时写主库时请改 false。
DB_FALLBACK_ENABLED=true
# 探测主库间隔（秒）；0 = 只在启动时选库，运行中不切换
DB_PROBE_INTERVAL=30
# 主库 → SQLite 镜像间隔（秒）；0 = 不周期镜像（启动时仍镜像一次）
DB_MIRROR_INTERVAL=300

# --- 存储 ---
# 留空则为项目下的 storage 目录
STORAGE_DIR=
THUMB_ENABLED=true

# --- 配额与上传 ---
DEFAULT_QUOTA_GB=10
MAX_FILE_SIZE_MB=4096
CHUNK_SIZE_MB=5
UPLOAD_SESSION_TTL_HOURS=72

# --- 注册 ---
ALLOW_REGISTER=true

# --- 监听与对外地址 ---
# 这两项只在 `python run.py` / `python main.py` 启动时生效。
# 直接 `uvicorn main:app` 或 IDE 的 uvicorn 运行器不读 .env，会用 127.0.0.1:8000。
# 0.0.0.0 = 监听所有网卡（局域网/公网可访问）；127.0.0.1 = 仅本机
# ⚠️ 0.0.0.0 只是监听地址，浏览器打不开：本机请用 http://localhost:8000
HOST=0.0.0.0
PORT=8000
RELOAD=false
# 对外站点地址：绑了域名/反向代理/HTTPS 后填这里，分享链接与 WebDAV 地址会用它
# 例：SITE_URL=https://pan.example.com
SITE_URL=
# 由 uvicorn 直接提供 HTTPS 时填证书；交给 Nginx/Caddy 做 TLS 就留空
SSL_CERTFILE=
SSL_KEYFILE=
SSL_KEYFILE_PASSWORD=
# 反向代理转发时信任 X-Forwarded-Proto / X-Forwarded-For
TRUST_PROXY=true

# --- 在线预览插件 ---
# 投屏需要 Chrome + Google Cast SDK（国内通常不可达），默认关闭
PREVIEW_CHROMECAST=false
# VAST 贴片广告地址，留空即不加载广告插件
PREVIEW_VAST_TAG=

# --- 歌词（音频预览全屏歌词）---
# 可以同时启用多个来源，前端「搜索指定」里会出现来源分类切换：
#   netease（网易云，免密钥） / lyriclib（MC22 自建歌词库，需密钥）
# 推荐直接去「管理后台 → 系统设置 → 歌词来源」配：来源开关、地址、密钥、Cookie 都在那里，
# 保存即生效；那边的值优先于本文件，留空 = 继续用这里。
# LYRICS_PROVIDERS 逗号分隔，顺序就是自动匹配与默认来源的优先级；
# 留空则退回下面的单值 LYRICS_PROVIDER（老配置照常工作）。
# 两者都空时：配了歌词库密钥就两个都启用，否则只有网易云。
# 写成 all 表示把所有来源都启用。
# 两套来源的凭据分开放、互不影响，可以同时保留。
# 凭据只放服务端，前端经 /api/lyrics 代理访问。
LYRICS_PROVIDERS=netease,lyriclib
LYRICS_PROVIDER=netease

# 来源 A：网易云
# 推荐直接去「管理后台 → 系统设置 → 网易云歌词」扫码登录，Cookie 由服务端加密保存，不用手抄。
# 这里仍然可以手填网页版 Cookie（至少含 MUSIC_U=...）：配了能拿逐字歌词（yrc）与翻译，
# 留空也能用（逐行 lrc）。两处都有时优先后台登录的那份。
NETEASE_COOKIE=

# 来源 B：MC22 歌词库（自建，minecraftmc22.top）
LYRICS_API_BASE=https://minecraftmc22.top/lyric/api/v1
LYRICS_API_KEY=
# 歌词库站点自身的 Cookie（部分接口在登录态下才返回逐字/翻译；留空即不带）
LYRICS_API_COOKIE=

# --- 看板娘 AI 对话 ---
# 总开关：false 时整块 AI 功能不可用（对话入口隐藏、接口 403）。改完要重启服务。
AI_ENABLED=true

# 默认接口：开启后用户不用自己填 API，打开看板娘就能聊。
# 地址与密钥只对管理员可见（管理后台 → 系统设置 → 看板娘 AI 默认接口），
# 普通用户的 /api/ai/config 响应里不会出现它们；用户自己填了完整配置就用自己的。
# 后台卡片里改的值优先于这里（存 system_settings，热生效）。
AI_DEFAULT_ENABLED=false
AI_DEFAULT_BASE_URL=
AI_DEFAULT_API_KEY=
AI_DEFAULT_MODEL=
# 高级配置：auto / openai / anthropic；图片输入、思考模式、工具调用；输入输出上限（0 = 服务商默认）
AI_DEFAULT_PROTOCOL=auto
AI_DEFAULT_VISION=false
AI_DEFAULT_THINKING=false
AI_DEFAULT_TOOLS=true
AI_DEFAULT_MAX_INPUT=0
AI_DEFAULT_MAX_OUTPUT=0

# --- 版本检查（只读，不会自动改代码/重启）---
# 检查 GitHub main 分支的版本号；私有仓库需要只读令牌（fine-grained PAT：Contents Read）
UPDATE_REPO=minecraftmc22/CloudNETP
UPDATE_TOKEN=
# 国内直连 GitHub 被重置时可填本地代理
UPDATE_PROXY=
# 自定义重启命令（systemd / nssm 等托管时填，例如 systemctl restart cloudnetp）
# 留空则自动更新后由 scripts/restart_helper.py 等端口释放再拉起 run.py
CLOUDNETP_RESTART_CMD=
