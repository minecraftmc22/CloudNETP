storage/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 编辑器
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

